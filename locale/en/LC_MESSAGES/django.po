msgid "Nuestra<br>Identidad"
msgstr "Gure<br>Nortasuna"

#: .\appIurrelan\templates\empresa.html:7
msgid "Ingeniería, compromiso y precisión desde hace más de 35 años"
msgstr "Ingeniaritza, konpromisoa eta zehaztasuna duela 35 urte baino gehiagotik"

