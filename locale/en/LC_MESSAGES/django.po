#: .\appIurrelan\templates\empresa.html:62
msgid "El Futuro"
msgstr "Etorkizuna"

#: .\appIurrelan\templates\empresa.html:63
msgid ""
"Consolidarnos como el socio estratégico de referencia en el sector "
"industrial del norte de España, impulsando la innovación en cada soldadura y "
"mecanizado."
msgstr ""
"Espainiako iparraldeko industria-sektorean erreferentziazko bazkide "
"estrategiko gisa sendotzea, soldadura eta mekanizatu bakoitzean berrikuntza "
"bultzatuz."

